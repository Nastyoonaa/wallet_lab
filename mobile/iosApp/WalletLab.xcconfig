PRODUCT_NAME = WalletLab
PRODUCT_BUNDLE_IDENTIFIER = lab.wallet.ios
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
IPHONEOS_DEPLOYMENT_TARGET = 15.0
TARGETED_DEVICE_FAMILY = 1,2
SWIFT_VERSION = 5.0
INFOPLIST_FILE = Info.plist
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = Wallet Lab
ENABLE_USER_SCRIPT_SANDBOXING = NO
FRAMEWORK_SEARCH_PATHS = $(inherited) "$(SRCROOT)/../shared/build/xcode-frameworks/$(CONFIGURATION)/$(SDK_NAME)"
OTHER_LDFLAGS = $(inherited) -framework WalletShared -lc++
ALWAYS_SEARCH_USER_PATHS = NO
