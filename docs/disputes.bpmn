<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="WalletLabDefinitions" targetNamespace="urn:wallet-lab:disputes">
  <bpmn:process id="DisputeProcess" name="Спорный перевод и возврат" isExecutable="false">
    <bpmn:laneSet id="Roles">
      <bpmn:lane id="Customer" name="Отправитель">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>File</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Operator" name="Оператор">
        <bpmn:flowNodeRef>Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Execute</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="System" name="Wallet Lab">
        <bpmn:flowNodeRef>Funds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="File" name="Подать обращение">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Review" name="Вынести решение с причиной">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Decision" name="Одобрено?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Rejected" name="Отклонено">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Execute" name="Запустить выплату или повторить">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Funds" name="Средств достаточно?">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Wait" name="Сохранить ожидание средств">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Post" name="Провести обратный перевод">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Done" name="Исполнено">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="Start" targetRef="File" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="File" targetRef="Review" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Review" targetRef="Decision" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Decision" targetRef="Rejected" name="Нет" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Decision" targetRef="Execute" name="Да" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Execute" targetRef="Funds" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Funds" targetRef="Wait" name="Нет" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Wait" targetRef="Execute" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Funds" targetRef="Post" name="Да" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Post" targetRef="Done" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="DisputeDiagram">
    <bpmndi:BPMNPlane id="DisputePlane" bpmnElement="DisputeProcess">
      <bpmndi:BPMNShape id="Shape_Customer" bpmnElement="Customer" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="1080" height="110" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Operator" bpmnElement="Operator" isHorizontal="true">
        <dc:Bounds x="0" y="110" width="1080" height="145" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_System" bpmnElement="System" isHorizontal="true">
        <dc:Bounds x="0" y="255" width="1080" height="105" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="Start">
        <dc:Bounds x="75" y="38" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_File" bpmnElement="File">
        <dc:Bounds x="150" y="25" width="155" height="62" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Review" bpmnElement="Review">
        <dc:Bounds x="150" y="134" width="155" height="62" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Decision" bpmnElement="Decision">
        <dc:Bounds x="353" y="143" width="44" height="44" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Rejected" bpmnElement="Rejected">
        <dc:Bounds x="473" y="147" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Execute" bpmnElement="Execute">
        <dc:Bounds x="585" y="134" width="155" height="62" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Funds" bpmnElement="Funds">
        <dc:Bounds x="641" y="274" width="44" height="44" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Wait" bpmnElement="Wait">
        <dc:Bounds x="405" y="265" width="150" height="62" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Post" bpmnElement="Post">
        <dc:Bounds x="782" y="265" width="160" height="62" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Done" bpmnElement="Done">
        <dc:Bounds x="998" y="278" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_0" bpmnElement="Flow_0">
        <di:waypoint x="111" y="56" />
        <di:waypoint x="150" y="56" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_1" bpmnElement="Flow_1">
        <di:waypoint x="228" y="87" />
        <di:waypoint x="228" y="134" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_2" bpmnElement="Flow_2">
        <di:waypoint x="305" y="165" />
        <di:waypoint x="353" y="165" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_3" bpmnElement="Flow_3">
        <di:waypoint x="397" y="165" />
        <di:waypoint x="473" y="165" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_4" bpmnElement="Flow_4">
        <di:waypoint x="375" y="187" />
        <di:waypoint x="375" y="222" />
        <di:waypoint x="610" y="222" />
        <di:waypoint x="610" y="196" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_5" bpmnElement="Flow_5">
        <di:waypoint x="663" y="196" />
        <di:waypoint x="663" y="274" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_6" bpmnElement="Flow_6">
        <di:waypoint x="641" y="296" />
        <di:waypoint x="555" y="296" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_7" bpmnElement="Flow_7">
        <di:waypoint x="480" y="265" />
        <di:waypoint x="480" y="241" />
        <di:waypoint x="731" y="241" />
        <di:waypoint x="731" y="196" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_8" bpmnElement="Flow_8">
        <di:waypoint x="685" y="296" />
        <di:waypoint x="782" y="296" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_9" bpmnElement="Flow_9">
        <di:waypoint x="942" y="296" />
        <di:waypoint x="998" y="296" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>